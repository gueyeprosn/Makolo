# ---------------------------------------------------------------------------
# MAKALO — Variables d'environnement
# ---------------------------------------------------------------------------
# Copiez ce fichier vers `.env` puis renseignez vos identifiants Supabase.
# Sans ces variables, l'application demarre en MODE DEMONSTRATION (donnees
# fictives en memoire) : aucune donnee n'est persistee sur un serveur.
#
# IMPORTANT : n'utilisez JAMAIS la cle `service_role` ici. Seule la cle
# publique `anon` doit etre exposee au navigateur. La securite reelle est
# assuree par les policies RLS definies dans scripts/sql/02_rls.sql.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
